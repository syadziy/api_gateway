{
  "baseUrl": "http://localhost:9001",
  "routes": [
    {
      "routeId": "centralized-alert",
      "paths": ["/api/v1/alert", "/api/v1/alert/**"],
      "upstream": "ALERT_SERVICE_URI",
      "requiredAuthorities": [
        "SCOPE_alert.write",
        "SCOPE_alert.read-recipients",
        "SCOPE_alert.manage-recipients"
      ]
    },
    {
      "routeId": "centralized-alert-websocket",
      "paths": ["/ws/alerts"],
      "upstream": "ALERT_WEBSOCKET_URI",
      "handshake": "public",
      "stompConnectAuthority": "PERM_alert:read-notifications"
    },
    {
      "routeId": "scheduler",
      "paths": [
        "/api/v1/tasks/**",
        "/api/v1/task-groups/**",
        "/api/v1/schedules/**",
        "/api/v1/histories/**"
      ],
      "upstream": "SCHEDULER_SERVICE_URI",
      "requiredAuthorities": ["SCOPE_scheduler.manage", "SCOPE_scheduler.read"]
    },
    {
      "routeId": "audit-log",
      "paths": ["/api/v1/audit-logs", "/api/v1/audit-logs/**"],
      "upstream": "AUDIT_SERVICE_URI",
      "requiredAuthority": "SCOPE_audit.read"
    },
    {
      "routeId": "centralized-log",
      "paths": ["/api/v1/gateway-logs", "/api/v1/gateway-logs/**"],
      "upstream": "CENTRALIZED_LOG_SERVICE_URI",
      "requiredAuthority": "SCOPE_audit.read"
    },
    {
      "routeId": "usermanagement",
      "paths": ["/api/v1/auth/**", "/api/v1/tenants", "/api/v1/tenants/**"],
      "upstream": "USERMANAGEMENT_SERVICE_URI",
      "publicOperations": [
        "POST /api/v1/auth/login",
        "POST /api/v1/tenants"
      ],
      "protectedAuthorities": [
        "SCOPE_tenant.view",
        "SCOPE_tenant.update",
        "SCOPE_user.view",
        "SCOPE_user.create",
        "SCOPE_role.assign",
        "SCOPE_role.view",
        "SCOPE_role.create",
        "SCOPE_role.edit",
        "SCOPE_permission.view",
        "SCOPE_permission.create"
      ]
    }
  ],
  "example": {
    "method": "GET",
    "url": "http://localhost:9001/api/v1/audit-logs?limit=20",
    "headers": {
      "Authorization": "Bearer <access-token>",
      "X-Correlation-Id": "audit-query-001",
      "X-Client-Id": "operations-ui"
    }
  }
}
