{
  "baseUrl": "http://localhost:9000",
  "routes": [
    {
      "routeId": "centralized-alert",
      "paths": ["/api/v1/alert", "/api/v1/alert/**"],
      "upstream": "ALERT_SERVICE_URI",
      "requiredAuthority": "SCOPE_alert.write"
    },
    {
      "routeId": "scheduler",
      "paths": [
        "/api/v1/tasks/**",
        "/api/v1/task-groups/**",
        "/api/v1/schedules/**",
        "/api/v1/histories/**"
      ],
      "upstream": "SCHEDULER_SERVICE_URI",
      "requiredAuthorities": ["SCOPE_scheduler.manage", "SCOPE_scheduler.read"]
    },
    {
      "routeId": "audit-log",
      "paths": ["/api/v1/audit-logs", "/api/v1/audit-logs/**"],
      "upstream": "AUDIT_SERVICE_URI",
      "requiredAuthority": "SCOPE_audit.read"
    }
  ],
  "example": {
    "method": "GET",
    "url": "http://localhost:9000/api/v1/audit-logs?limit=20",
    "headers": {
      "Authorization": "Bearer <access-token>",
      "X-Correlation-Id": "audit-query-001",
      "X-Client-Id": "operations-ui"
    }
  }
}
