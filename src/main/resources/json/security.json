    "/api/v1/tasks/**": "scheduler.manage",
    "/api/v1/task-groups/**": "scheduler.manage",
    "/api/v1/schedules/**": "scheduler.manage"
  },
  "sampleClaims": {
    "sub": "user-123",
    "iss": "https://identity.example.com/realms/platform",
    "aud": ["api-gateway"],
    "scope": "audit.read scheduler.read"
  }
}
